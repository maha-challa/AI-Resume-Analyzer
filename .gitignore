# ==============================================================================
# Git Ignore Configuration - AI Resume Analyzer
# ==============================================================================

# Environment variables & secrets (CRITICAL: Never commit to version control)
.env
.env.*
!.env.example

# Python virtual environment
venv/
env/
ENV/
.venv/

# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Logs & temporary files
*.log
