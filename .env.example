# ==============================================================================
# Database Configuration Template (Copy this to .env and fill in your values)
# ==============================================================================

# Option 1: Individual Database Parameters (Local / Standard Hosting)
DB_HOST=localhost
DB_PORT=3306
DB_USER=resume_user
DB_PASSWORD=your_mysql_password_here
DB_NAME=ai_resume_analyzer
DB_SSL=false

# Option 2: Cloud Database URL (Used by platforms like Railway, Render, Aiven)
# DATABASE_URL=mysql://username:password@host:port/database_name

# Flask Application Secret Key
FLASK_SECRET_KEY=your_random_flask_secret_key_here
